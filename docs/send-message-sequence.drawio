        <!-- Legend -->
        <mxCell id="leg" value="Bang trang thai (UserA UI - ListMess)&#xa;&#xa;1. SENDING  = &quot;Dang gui&quot;   - optimistic, chua ACK&#xa;2. SENT      = &quot;Da gui&quot;     - UC-1: server luu + MESSAGE_ACK&#xa;3. DELIVERED = &quot;Da nhan&quot;    - UC-2: UserB online nhan NEW_MESSAGE + sendDelivered&#xa;4. SEEN      = &quot;Da xem&quot;     - UC-3: UserB mo conversation + sendSeen&#xa;&#xa;Priority: SENDING(0) &lt; SENT(1) &lt; DELIVERED(2) &lt; SEEN(3)&#xa;Chi cap nhat neu status moi &gt; status cu (setVisibleStatusIfNewer)" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="1120" y="140" width="340" height="220" as="geometry"/>
        </mxCell>

        <mxCell id="leg2" value="Quy uoc ve UML&#xa;- Mui ten solid: call / request&#xa;- Mui ten dashed: return / event response&#xa;- Khung ref: 1 Use Case&#xa;- Pre / Post: dieu kien truoc / sau UC" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
