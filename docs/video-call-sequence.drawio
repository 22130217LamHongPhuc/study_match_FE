        </mxCell>
        <mxCell id="m20" value="19: endCall + duration +&#xa;saveCallHistory(COMPLETED)" style="endArrow=block;html=1;endFill=1;fontSize=11;verticalAlign=bottom;" edge="1" parent="1">
