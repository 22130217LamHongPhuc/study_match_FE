        <mxCell id="uc4t" value="UC-4: End call  |  Post: session COMPLETED, history + VIDEO_CALL_ENDED" style="text;html=1;align=left;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="170" y="1235" width="650" height="20" as="geometry"/>
