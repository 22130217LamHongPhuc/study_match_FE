            <mxPoint x="825" y="1460" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <mxCell id="note" value="Technical notes&#xa;- Media: ZegoUIKitPrebuilt (no raw WebRTC)&#xa;- Signaling: REST + STOMP /user/queue/chat&#xa;- callType: AUDIO | VIDEO&#xa;- roomId: studymatch_call_{sessionId}&#xa;- History message type: CALL_AUDIO / CALL_VIDEO&#xa;  status: MISSED | COMPLETED&#xa;- Outgoing wait: ConversationPage&#xa;- Incoming + room: MainLayout (global)" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1">
