        <mxCell id="m21" value="20: VIDEO_CALL_ENDED + NEW_MESSAGE&#xa;(CALL_AUDIO | CALL_VIDEO)" style="endArrow=block;html=1;endFill=1;fontSize=11;verticalAlign=bottom;" edge="1" parent="1">
