        </mxCell>
        <mxCell id="m3" value="3: PATCH /api/study-sessions/{sessionId}&#xa;/participants/{userId}/respond&#xa;body: { status: ACCEPTED | DECLINED }" style="endArrow=block;html=1;endFill=1;fontSize=11;verticalAlign=bottom;" edge="1" parent="1">
