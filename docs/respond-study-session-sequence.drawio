        <mxCell id="m6" value="6: setStatus(ACCEPTED|DECLINED)&#xa;setRespondedAt(now) + save" style="endArrow=block;html=1;endFill=1;fontSize=11;verticalAlign=bottom;" edge="1" parent="1">
