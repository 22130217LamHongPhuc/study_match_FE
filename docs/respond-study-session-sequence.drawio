        <mxCell id="pre" value="Pre: participant.status = PENDING&#xa;Entry A: Header pending invites&#xa;Entry B: /schedule SessionDetailModal" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1">
