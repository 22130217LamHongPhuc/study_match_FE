        <mxCell id="note" value="Statuses&#xa;PENDING - request open&#xa;APPROVED - accepted + friends row&#xa;REJECTED - declined by receiver&#xa;CANCELLED - withdrawn by sender&#xa;&#xa;Notes&#xa;- Friendship created only on APPROVED&#xa;- Realtime via chat_service relay&#xa;- Unfriend: DELETE /social/friends/unfriend&#xa;- Entry: Profile, Search, StudyConnection, Header, Home" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1">
